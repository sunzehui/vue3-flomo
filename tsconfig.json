{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "module": "esnext",
    "target": "es2020",
    "noImplicitThis": true,
    "lib": ["esnext", "dom", "es2020"],
    "jsx": "preserve",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "types": [
      "vite/client",
      "element-plus/global"
    ],
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"],
  "typeAcquisition": {
    "include": [
      "lodash"
    ]
  },
  "vueCompilerOptions": {
    "target": 3
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/types/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/components/**/src/*.ts",
    "src/components/**/*.ts"
  ]
}
